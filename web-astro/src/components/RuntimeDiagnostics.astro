<section class="panel metrics-panel">
  <div class="panel-head">
    <p class="panel-kicker">Telemetry</p>
    <h2>Frame metrics</h2>
  </div>

  <dl class="metric-grid">
    <div>
      <dt>Runtime</dt>
      <dd data-role="runtime-status">Loading module…</dd>
    </div>
    <div>
      <dt>Renderer</dt>
      <dd data-role="backend-badge">Canvas2D reference</dd>
    </div>
    <div>
      <dt>Frame</dt>
      <dd data-role="frame-badge">Waiting for first frame</dd>
    </div>
    <div>
      <dt>Delta</dt>
      <dd data-role="delta-stat">0.0 ms</dd>
    </div>
    <div>
      <dt>FPS</dt>
      <dd data-role="fps-stat">0.0</dd>
    </div>
    <div>
      <dt>Commands</dt>
      <dd data-role="command-stat">0 records</dd>
    </div>
    <div>
      <dt>Text</dt>
      <dd data-role="text-stat">0 bytes</dd>
    </div>
    <div>
      <dt>Points</dt>
      <dd data-role="point-stat">0 vertices</dd>
    </div>
    <div>
      <dt>Module imports</dt>
      <dd data-role="import-stat">0 imports</dd>
    </div>
  </dl>
</section>

<section class="panel">
  <div class="panel-head">
    <p class="panel-kicker">Module surface</p>
    <h2>Exports</h2>
  </div>
  <ul class="token-list" data-role="export-list">
    <li>No module yet.</li>
  </ul>
</section>

<section class="panel">
  <div class="panel-head">
    <p class="panel-kicker">Instantiation</p>
    <h2>Imports</h2>
  </div>
  <ul class="token-list" data-role="import-list">
    <li>Pending module inspection.</li>
  </ul>
</section>

<section class="panel">
  <div class="panel-head">
    <p class="panel-kicker">Diagnostics</p>
    <h2>Runtime notes</h2>
  </div>
  <ul class="note-list" data-role="diagnostics-log">
    <li>Bridge assumptions, buffer faults, and runtime notes land here.</li>
  </ul>
</section>
